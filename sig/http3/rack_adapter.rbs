module HTTP3
  # Calls a Rack 3 application for a Request and turns its answer into a
  # Response.
  class RackAdapter
    class InvalidResponse < StandardError
    end

    CONNECTION_FIELDS: Array[String]
    FIELD_NAME: Regexp
    FORBIDDEN_IN_VALUE: Regexp
    # The schemes a request may have.
    SCHEMES: Array[String]
    # What :authority, or host, must look like.
    AUTHORITY: Regexp

    # A body read with each goes through a Body::Pipe of pipe_capacity
    # bytes, whose wake is wake.
    def initialize: (untyped app, pipe_capacity: Integer, wake: ^() -> void) -> void

    # Returns [response, fill]. Answers, without calling the application,
    # CONNECT with 501, and with 400 a request whose scheme is not http or
    # https, whose path has a fragment, or whose authority is malformed or
    # differs from its host field. Raises what the application raises, and
    # InvalidResponse for an answer that cannot be sent (among them a
    # status outside 200..599, and a content-length that is malformed or
    # that a file or array body does not have); the Rack body is closed
    # either way. fill is nil, the Rack body closed already, unless the
    # body is read with each: then the response has a Body::Pipe, and fill
    # writes the body to it, fails it once the body passes content-length,
    # ends short of it, yields a chunk that is not a String or raises, and
    # closes the Rack body.
    def call: (Request request, remote: Addrinfo) -> [Response, (^() -> void)?]

    # The 400s and 501s #call answered since the last call, as
    # {status => count}; the count starts over.
    def take_refusals: () -> Hash[Integer, Integer]
  end
end

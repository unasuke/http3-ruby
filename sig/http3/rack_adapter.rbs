module HTTP3
  # Calls a Rack 3 application for a Request and turns its answer into a
  # Response.
  class RackAdapter
    class InvalidResponse < StandardError
    end

    CONNECTION_FIELDS: Array[String]
    FIELD_NAME: Regexp
    FORBIDDEN_IN_VALUE: Regexp
    # The schemes a request may have.
    SCHEMES: Array[String]
    # What :authority, or host, must look like.
    AUTHORITY: Regexp

    def initialize: (untyped app) -> void

    # Answers 400, without calling the application, a request whose scheme
    # is not http or https, whose path has a fragment, or whose authority is
    # malformed or differs from its host field. Raises what the application
    # raises, and InvalidResponse for an answer that cannot be sent; the
    # Rack body is closed either way.
    def call: (Request request, remote: Addrinfo) -> Response
  end
end

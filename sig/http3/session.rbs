module HTTP3
  # HTTP/3 on one QUIC connection, driven by HTTP3::Server's I/O loop. The
  # on_* methods are called by the C part with the parts of each request.
  class Session
    # Take over quic_conn's streams. Requests over max_request_body bytes of
    # body get 413, over max_field_section_size bytes of headers 431.
    def self.attach: (QUIC::Connection::Server quic_conn, max_request_body: Integer, max_field_section_size: Integer) -> Session

    def self._attach: (QUIC::Connection::Server quic_conn, Integer max_field_section_size) -> Session

    # Finished requests, each with the status to answer it with directly
    # (413, 431) or nil for the application to answer it.
    def take_requests: () -> Array[[Request, Integer?]]

    # Send response. Yields the exception of a file body whose descriptor
    # could not be duplicated; its stream is aborted.
    def respond: (Request request, Response response) ?{ (SystemCallError error) -> void } -> void

    # Queue more of each Body::Chunks body, up to limit unsent bytes per
    # stream. Yields the request and exception of a body that raised.
    def fill_bodies: (Integer limit) ?{ (Request request, Exception error) -> void } -> void

    def wants_fill?: (Integer limit) -> bool

    # True while a request stream is open.
    def busy?: () -> bool

    # Let go of closed streams; yields a body close that raised.
    def release_closed: () ?{ (Integer stream_id, Exception error) -> void } -> void

    # Close every body still held.
    def release_all: () ?{ (Integer stream_id, Exception error) -> void } -> void

    def on_begin_headers: (Integer id) -> void
    def on_header: (Integer id, String name, String value) -> void
    def on_fields_too_large: (Integer id) -> void
    def on_end_headers: (Integer id) -> void
    def on_data: (Integer id, String bytes) -> void
    def on_end_stream: (Integer id) -> void

    # The C part.
    def submit_response: (Integer stream_id, Array[[String, String]] headers, bool has_body) -> self
    def push_chunk: (Integer stream_id, String str) -> self
    def push_eof: (Integer stream_id) -> self
    def attach_file: (Integer stream_id, IO io, Integer offset, Integer length) -> self
    def unsent_bytes: (Integer stream_id) -> Integer
    def take_closed: () -> Array[Integer]
    def take_error: () -> Exception?
    def shutdown_notice: () -> self
    def abort_stream: (Integer stream_id, Integer app_error_code) -> self
  end
end

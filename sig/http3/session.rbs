module HTTP3
  # HTTP/3 on one QUIC connection, driven by HTTP3::Server's I/O loop. The
  # on_* methods are called by the C part with the parts of each request.
  class Session
    # What .shared_buffer returns, to be passed to .attach as it is.
    type shared_buffer = Object

    # What .shared_spool returns, to be passed to .attach as it is.
    type shared_spool = Object

    # What a field counts for besides its name and value (RFC 9114 section
    # 4.2.2).
    FIELD_OVERHEAD: Integer

    # Take over quic_conn's streams. Requests over max_request_body bytes of
    # body get 413, over max_field_section_size bytes of headers 431, as
    # soon as they pass the limit; the rest of them is not read. Requests
    # may hold max_connection_request_buffer bytes, and those of every
    # Session sharing shared_buffer its limit; more gets 503. One not in
    # full within request_timeout seconds of its headers gets 408, and one
    # not handed out within request_timeout seconds of its end 503
    # (#expire_requests); nil is no limit. A body past
    # request_body_buffer_size bytes goes to a temporary file, all of it
    # (.spool_file). The files may hold max_connection_request_spool bytes
    # and be max_connection_request_spool_files many; those of every
    # Session sharing shared_spool count against its limits. More, or a
    # file that cannot be made or written, gets 503. A request counts until
    # its stream closes, or, once handed out, until #finish, though its
    # stream or connection has gone.
    def self.attach: (QUIC::Connection::Server quic_conn, max_request_body: Integer, max_field_section_size: Integer,
                      ?max_connection_request_buffer: Integer, ?shared_buffer: shared_buffer?,
                      ?request_timeout: (Integer | Float)?, ?request_body_buffer_size: Integer,
                      ?max_connection_request_spool: Integer, ?max_connection_request_spool_files: Integer,
                      ?shared_spool: shared_spool?) -> Session

    # A limit of limit bytes for the requests of every Session given it.
    def self.shared_buffer: (Integer limit) -> shared_buffer

    # Limits of limit bytes in temporary files, and of files open at once,
    # for the requests of every Session given it.
    def self.shared_spool: (Integer limit, files: Integer) -> shared_spool

    # A temporary file without a name in Dir.tmpdir, in binary mode.
    # Raises SystemCallError when none can be had.
    def self.spool_file: () -> ::File

    def self._attach: (QUIC::Connection::Server quic_conn, Integer max_field_section_size) -> Session

    # The requests refused since the last call, each with the status to
    # answer it with directly (408, 413, 431, 503). One comes out as soon
    # as it is refused, with neither headers nor body.
    def take_refusals: () -> Array[[Request, Integer]]

    # The next request received in full, for the application, or nil. The
    # caller closes its input, and calls #finish, once done with it; what
    # it holds counts until then, even after its stream has closed.
    def next_request: () -> Request?

    # The caller is done with a request #next_request handed out: what it
    # held no longer counts, though its stream or connection has gone.
    # Calling it again does nothing.
    def finish: (Integer stream_id) -> void

    # True while the request on stream_id can still be answered: its stream
    # is open, and it has been neither reset by the client, nor refused,
    # nor answered.
    def answerable?: (Integer stream_id) -> bool

    # The first exception a temporary file raised since the last call (its
    # request got 503), or nil.
    def take_spool_error: () -> Exception?

    # Refuse with 408 the requests still coming in whose request_timeout
    # has passed at now (CLOCK_MONOTONIC), and with 503 those that have
    # waited that long to be handed out.
    def expire_requests: (Float now) -> void

    # When the next request still coming in, or waiting to be handed out,
    # runs out of time, or nil.
    def next_request_deadline: () -> Float?

    # Send response. Yields the exception of a file body whose descriptor
    # could not be duplicated; its stream is aborted. Raises
    # Nghttp3::InvalidStateError for a request already answered.
    def respond: (Request request, Response response) ?{ (SystemCallError error) -> void } -> void

    # Queue more of each Body::Chunks and Body::Pipe body, up to limit
    # unsent bytes per stream, connection_limit on the connection, and room
    # bytes queued now (nil for no limit); a chunk may pass a limit.
    # Returns the bytes queued. Yields the request (its pseudo-headers
    # only, without body) and exception of a body that raised or failed.
    def fill_bodies: (Integer limit, ?connection_limit: Integer?, ?room: Integer?) ?{ (Request request, Exception error) -> void } -> Integer

    # True when a Body::Chunks body, or a Body::Pipe with something to
    # take, could take more.
    def wants_fill?: (Integer limit, ?connection_limit: Integer?, ?room: Integer?) -> bool

    # Bytes of the Body::Chunks and Body::Pipe bodies queued but not taken
    # by nghttp3 yet.
    def unsent_total: () -> Integer

    # True while a request stream is open, or a request waits to be handed
    # out.
    def busy?: () -> bool

    # Let go of closed streams (a Body::Pipe is cancelled); yields a body
    # close that raised. Resets our side of the requests the client reset
    # before their end (H3_REQUEST_INCOMPLETE), and of those it reset while
    # they waited to be handed out (H3_REQUEST_CANCELLED).
    def release_closed: () ?{ (Integer stream_id, Exception error) -> void } -> void

    # Close every body still held. What the requests handed out hold counts
    # until #finish.
    def release_all: () ?{ (Integer stream_id, Exception error) -> void } -> void

    # Called inside nghttp3, or inside the QUIC connection's packet
    # handling, where submit_response, stop_reading, push_chunk, push_eof,
    # attach_file, shutdown_notice and abort_stream (and so respond) raise
    # Nghttp3::InvalidStateError.
    def on_begin_headers: (Integer id) -> void
    def on_header: (Integer id, String name, String value) -> void
    def on_fields_too_large: (Integer id) -> void
    def on_end_headers: (Integer id) -> void
    def on_data: (Integer id, String bytes) -> void
    def on_end_stream: (Integer id) -> void
    # The client reset its side of the stream.
    def on_reset: (Integer id) -> void

    # The C part.
    def submit_response: (Integer stream_id, Array[[String, String]] headers, bool has_body) -> self
    # Read no more of the request on stream_id (STOP_SENDING with
    # H3_NO_ERROR); for one answered before it has arrived in full.
    def stop_reading: (Integer stream_id) -> self
    def push_chunk: (Integer stream_id, String str) -> self
    def push_eof: (Integer stream_id) -> self
    def attach_file: (Integer stream_id, IO io, Integer offset, Integer length) -> self
    def unsent_bytes: (Integer stream_id) -> Integer
    def take_closed: () -> Array[Integer]
    def take_error: () -> Exception?
    def shutdown_notice: () -> self
    def abort_stream: (Integer stream_id, Integer app_error_code) -> self
  end
end

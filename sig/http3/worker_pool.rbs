module HTTP3
  # Threads that run the jobs posted to them, one at a time each.
  class WorkerPool
    # The priority of the threads, the least MRI has.
    WORKER_PRIORITY: Integer

    def initialize: (Integer size) -> void

    # Make the threads, named "http3-worker-1" and on.
    def start: () -> self

    # Queue a job for the next free thread, without waiting.
    def post: () { () -> void } -> self

    # Drop the jobs not started, and wait up to timeout seconds for the
    # threads to end. Returns the number still running.
    def stop: (Numeric timeout) -> Integer
  end
end
